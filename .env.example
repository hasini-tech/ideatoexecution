# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/idea-to-execution?retryWrites=true&w=majority

# Long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me

# Web Push (generate with: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret used by the scheduled job endpoint (/api/cron/reminders)
CRON_SECRET=change-me-too

# Self-hosted only: run the reminder job inside the Node server every 5 minutes
ENABLE_INTERNAL_CRON=false
